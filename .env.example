# Fichier optionnel : copie-le vers .env (gitignore) pour des reglages de
# developpement. scripts/flutter.sh le passe automatiquement via
# --dart-define-from-file aux commandes run/build/test.
#
# Les cles API Renault ne se configurent pas ici : l'app les recupere
# depuis renault-api a la connexion (choix du pays).
#
# Reglages disponibles :
# DEV_TOOLS=true   # outils de developpement (tests d'ecriture...) meme en release
